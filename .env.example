# Nivara — AI Livelihood Guidance Assistant Environment Configuration

# -------------------------------------------------------------
# 1. LLM API Keys (Recommended: Free-tier Groq or Google AI Studio Gemini)
# If provided, the assistant uses ultra-fast LLM extraction for conversational profiling.
# Free Options:
#   - Groq (Free & Fast): https://console.groq.com -> GROQ_API_KEY
#   - Google Gemini (Free tier): https://aistudio.google.com -> GEMINI_API_KEY
# If omitted or offline, it gracefully falls back to deterministic rule-based profiling.
# -------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=

# -------------------------------------------------------------
# 2. MeitY Bhashini Speech API (ULCA / Dhruva) (Optional)
# Register at https://bhashini.gov.in or https://ulcacontrib.org to obtain credentials.
# Set MOCK_SPEECH=true to run without live credentials (uses canned ASR & browser TTS).
# -------------------------------------------------------------
BHASHINI_USER_ID=
BHASHINI_API_KEY=
MOCK_SPEECH=true

# -------------------------------------------------------------
# 3. Twilio WhatsApp Sandbox (Optional - Phase 5)
# Set your Twilio Account SID, Auth Token, and WhatsApp Sandbox Number.
# The webhook will be active at: http://your-host:8000/webhook/whatsapp
# Note: The in-app simulator at /whatsapp works 100% offline without live credentials.
# -------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Server port (default 8000)
PORT=8000
